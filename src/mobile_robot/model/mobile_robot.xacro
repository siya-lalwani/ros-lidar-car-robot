<?xml version="1.0"?>
<robot xmlns:xacro="https://www.ros.org/wiki/xacro" name="mobile_robot">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.30 0.20 0.10" />
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.30 0.20 0.10" />
            </geometry>
        </collision>
        <inertial>
            <mass value="2.0" />
            <origin xyz="0 0 0" />
            <inertia
                ixx="0.01"
                ixy="0"
                ixz="0"
                iyy="0.01"
                iyz="0"
                izz="0.02" />
        </inertial>
    </link>
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <origin xyz = "0 0 0"/>
            <inertia 
            ixx = "0.0002"
            ixy = "0"
            ixz="0"
            iyy="0.0002"
            iyz="0"
            izz="0.0001"/>
        </inertial>
    </link>
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <origin xyz = "0 0 0"/>
            <inertia 
            ixx = "0.0002"
            ixy = "0"
            ixz="0"
            iyy="0.0002"
            iyz="0"
            izz="0.0001"/>
        </inertial>
    </link>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 -0.12 -0.025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 0.12 -0.025" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
</robot>